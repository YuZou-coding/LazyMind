+    This is intentionally applied before an approval request is emitted: a user
+    can approve a risky operation inside the workspace, but cannot approve an
+    operation outside the authorization boundary.
+    """
+    for token in argv[1:]:
+        if not token or token == '--' or token.startswith('-') or '://' in token:
+            continue
+        looks_like_path = os.path.isabs(token) or token in ('.', '..') or any(
+            separator in token for separator in ('/', '\\')
+        )
+        if not looks_like_path:
