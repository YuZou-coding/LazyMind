+def _build_command_env(overrides: Optional[Dict[str, str]]) -> Dict[str, str]:
+    """Build the small, non-credential environment visible to workspace commands."""
+    allowed = {name.upper() for name in _COMMAND_ENV_ALLOWLIST}
+    result = {
+        name: value for name, value in os.environ.items()
+        if name.upper() in allowed
+    }
+    for name, value in (overrides or {}).items():
+        normalized = str(name).upper()
+        if normalized not in allowed:
+            raise ToolExecutionError(
+                f'Command environment variable {name!r} is not allowed for workspace execution.'
+            )
+        result[str(name)] = str(value)
+    return result
+
+
+def _redact_command_output(value: str, root: Optional[str]) -> str:
+    result = value or ''
+    if root:
+        normalized_root = os.path.realpath(root).rstrip(os.sep)
+        result = result.replace(normalized_root + os.sep, '.' + os.sep)
+        result = result.replace(normalized_root, '.')
+    for name, secret in os.environ.items():
+        upper = name.upper()
+        if secret and len(secret) >= 6 and any(marker in upper for marker in _SECRET_ENV_MARKERS):
+            result = result.replace(secret, '[REDACTED]')
+    return result
+
